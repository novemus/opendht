{
    "version": 6,
    "configurePresets": [
        {
            "name": "config-base",
            "hidden": true,
            "cacheVariables": {
                "OPENDHT_TOOLS": "OFF",
                "OPENDHT_C": "OFF",
                "OPENDHT_PEER_DISCOVERY": "OFF",
                "OPENDHT_PROXY_SERVER": "OFF",
                "OPENDHT_PYTHON": "OFF",
                "OPENDHT_PROXY_CLIENT": "OFF",
                "OPENDHT_SKIP_INSTALL_DEPS": "ON",
                "OPENDHT_CPACK": "ON",
                "BUILD_TESTING": "OFF",
                "CMAKE_POSITION_INDEPENDENT_CODE": "ON"
            },
            "installDir": "${sourceDir}/out/$env{TARGET_OS}/$env{TARGET_ARCH}/install",
            "binaryDir": "${sourceDir}/out/$env{TARGET_OS}/$env{TARGET_ARCH}/build/${presetName}"
        },
        {
            "name": "relwithdebinfo-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo"
            }
        },
        {
            "name": "release-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CONFIGURATION_TYPES": "Release"
            }
        },
        {
            "name": "debug-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CONFIGURATION_TYPES": "Debug",
                "CMAKE_DEBUG_POSTFIX": "d"
            }
        },
        {
            "name": "static-relwithdebinfo",
            "inherits": ["config-base", "relwithdebinfo-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
            }
        },
        {
            "name": "static-release",
            "inherits": ["config-base", "release-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
            }
        },
        {
            "name": "static-debug",
            "inherits": ["config-base", "debug-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebug"
            }
        },
        {
            "name": "shared-relwithdebinfo",
            "inherits": ["config-base", "relwithdebinfo-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
            }
        },
        {
            "name": "shared-release",
            "inherits": ["config-base", "release-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
            }
        },
        {
            "name": "shared-debug",
            "inherits": ["config-base", "debug-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "shared-debug",
            "displayName": "Debug",
            "configuration": "Debug",
            "configurePreset": "shared-debug"
        },
        {
            "name": "shared-release",
            "displayName": "Release",
            "configuration": "Release",
            "configurePreset": "shared-release"
        },
        {
            "name": "shared-relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "shared-relwithdebinfo"
        },
        {
            "name": "static-debug",
            "displayName": "Debug",
            "configuration": "Debug",
            "configurePreset": "static-debug"
        },
        {
            "name": "static-release",
            "displayName": "Release",
            "configuration": "Release",
            "configurePreset": "static-release"
        },
        {
            "name": "static-relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "static-relwithdebinfo"
        }
    ],
    "packagePresets": [
        {
            "name": "debian-package-lib",
            "displayName": "libopendht (DEB)",
            "description": "Debian library package",
            "configurePreset": "shared-relwithdebinfo",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generators": [
                "DEB"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "variables": {
                "CPACK_PACKAGING_INSTALL_PREFIX": "/opt",
                "CPACK_COMPONENTS_ALL": "library_files"
            },
            "packageName": "libopendht",
            "packageDirectory": ".."
        },
        {
            "name": "debian-package-dev",
            "displayName": "libopendht-dev (DEB)",
            "description": "Debian development package",
            "configurePreset": "static-relwithdebinfo",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generators": [
                "DEB"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "variables": {
                "CPACK_PACKAGING_INSTALL_PREFIX": "/opt",
                "CPACK_DEBIAN_PACKAGE_DEPENDS": "libopendht (>= 3.4.0), libgnutls28-dev, libmsgpack-cxx-dev, libargon2-dev, libasio-dev, libjsoncpp-dev, libhttp-parser-dev, libssl-dev, libfmt-dev, nettle-dev",
                "CPACK_COMPONENTS_ALL": "archive_files;header_files;config_files"
            },
            "packageName": "libopendht-dev",
            "packageDirectory": ".."
        },
        {
            "name": "rpm-package-lib",
            "displayName": "libopendht (RPM)",
            "description": "RPM library package",
            "configurePreset": "shared-relwithdebinfo",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generators": [
                "RPM"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "variables": {
                "CPACK_PACKAGING_INSTALL_PREFIX": "/opt",
                "CPACK_RPM_DEBUGINFO_PACKAGE": "ON",
                "CPACK_RPM_DEBUGINFO_SINGLE_PACKAGE": "ON",
                "CPACK_COMPONENTS_ALL": "library_files"
            },
            "packageName": "libopendht",
            "packageDirectory": ".."
        },
        {
            "name": "rpm-package-dev",
            "displayName": "libopendht-dev (RPM)",
            "description": "RPM development package",
            "configurePreset": "static-relwithdebinfo",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generators": [
                "RPM"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "variables": {
                "CPACK_PACKAGING_INSTALL_PREFIX": "/opt",
                "CPACK_RPM_PACKAGE_REQUIRES": "gnutls-devel, fmt-devel, nettle-devel, libargon2-devel, jsoncpp-devel, llhttp-devel, msgpack-devel, asio-devel, openssl-devel, libopendht = %{version}-%{release}",
                "CPACK_COMPONENTS_ALL": "archive_files;header_files;config_files"
            },
            "packageName": "libopendht-devel",
            "packageDirectory": ".."
        },
        {
            "name": "archive",
            "displayName": "Archive (ZIP)",
            "description": "Portable ZIP archive",
            "configurePreset": "static-relwithdebinfo",
            "generators": [
                "ZIP"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "variables": {
                "CPACK_COMPONENTS_ALL": "runtime_files;library_files;archive_files;header_files;config_files;debug_files",
                "CPACK_COMPONENTS_ALL_IN_ONE_PACKAGE": "ON",
                "CPACK_ARCHIVE_COMPONENT_INSTALL": "ON"
            },
            "packageDirectory": ".."
        }
    ]
}
