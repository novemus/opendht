@PACKAGE_INIT@

macro(import_targets _type)
    if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/opendht-${_type}-targets.cmake")
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "opendht ${_type} libraries were requested but not found")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND OFF)
        return()
    endif()

    include("${CMAKE_CURRENT_LIST_DIR}/opendht-${_type}-targets.cmake")
endmacro()

if(NOT TARGET opendht)
    set(_type "")

    if(BUILD_SHARED_LIBS AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/opendht-shared-targets.cmake")
        set(_type "shared")
    elseif(EXISTS "${CMAKE_CURRENT_LIST_DIR}/opendht-static-targets.cmake")
        set(_type "static")
    else()
        set(_type "shared")
    endif()

    import_targets(${_type})
    check_required_components(opendht)

    set(opendht_FOUND ON)
    unset(_type)
endif()
